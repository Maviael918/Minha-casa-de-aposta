{
  "name": "simulador-apostas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm run install:client && concurrently \"npm run server\" \"npm run client\"",
    "install:client": "npm install --prefix client",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
